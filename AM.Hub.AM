Tgl("玩家ESP",function(v)if v then local fol=Instance.new("Folder",game.CoreGui);fol.Name="AM_ESP"
C.esp=rs.RenderStepped:Connect(function()fol:ClearAllChildren()
for _,pl in pairs(game.Players:GetPlayers())do if pl~=p and pl.Character and pl.Character:FindFirstChild("Head")then
local bg=Instance.new("BillboardGui",fol);bg.Adornee=pl.Character.Head;bg.Size=UDim2.new(0,100,0,20);bg.AlwaysOnTop=true
local l=Instance.new("TextLabel",bg);l.Size=UDim2.new(1,0,1,0);l.BackgroundTransparency=1;l.Text=pl.Name;l.TextColor3=Color3.fromHSV(tick()%5/5,1,1);l.TextSc
