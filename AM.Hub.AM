-- 工具函数
local plr = game.Players.LocalPlayer
local function GChar() return plr.Character or plr.CharacterAdded:Wait() end
local function GHum()
    local c = GChar()
    return c:FindFirstChildWhichIsA("Humanoid") or c:WaitForChild("Humanoid", 5)
end
local function GHRP()
    local c = GChar()
    return c:FindFirstChild("HumanoidRootPart") or c:WaitForChild("HumanoidRootPart", 5)
end

-- 缓存原值
local orig = {}
local cached = false
local function Cache()
    if cached then return end
    pcall(function()
        local h = GHum()
        if h then orig.W = h.WalkSpeed; orig.J = h.JumpPower end
        orig.G = workspace.Gravity
        cached = true
    end)
end

-- 创建Tab
local T1 = Win:Tab({Title = "通用", Icon = "settings"})
local T2 = Win:Tab({Title = "视觉", Icon = "eye"})
local T3 = Win:Tab({Title = "ESP", Icon = "eye"})
local T4 = Win:Tab({Title = "设置", Icon = "settings"})

-- ===== 通用 =====
T1:Paragraph({
    Title = "玩家: " .. plr.Name .. " | ID: " .. plr.UserId,
    Desc = "账号年龄: " .. plr.AccountAge .. "天 | QQ群: 179051448",
    Color = Color3.fromHex("#00CCFF")
})

-- 移速
local spdOn, spdVal = false, 16
T1:Toggle({Title = "启用移速修改", Value = false, Callback = function(v)
    Cache()
    spdOn = v
    pcall(function() GHum().WalkSpeed = v and spdVal or (orig.W or 16) end)
end})
T1:Slider({Title = "移速值", Min = 1, Max = 600, Default = 16, Callback = function(v)
    spdVal = v
    if spdOn then pcall(function() GHum().WalkSpeed = v end) end
end})

