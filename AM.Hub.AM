-- AM Hub v2.0 - 极简稳定版
if _G.AM_L then return end
_G.AM_L = true

-- 加载WindUI
local W
local ok = pcall(function()
    W = loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/WindUI/main/main.lua"))()
end)
if not ok or not W then
    game.StarterGui:SetCore("SendNotification", {Title = "AM", Text = "WindUI加载失败", Duration = 5})
    _G.AM_L = nil
    return
end

-- 创建窗口
local Win = W:CreateWindow({
    Title = "AM Hub",
    Icon = "crown",
    Author = "AM官方制作",
    Folder = "AMHub",
    Size = UDim2.fromOffset(480, 560),
    Transparent = false,
    BackgroundColor = Color3.fromRGB(15, 15, 15),
    User = {Enabled = true, Callback = function() end, Anonymous = false}
})

-- 彩虹边框
spawn(function()
    while _G.AM_L do
